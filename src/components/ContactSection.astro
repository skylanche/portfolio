---
const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY

const DATA_SITE_KEY = import.meta.env.HCAPTCHA_SITE_KEY
---


<div class="contact-container">
  <div class="contact">
      <div class="contact-links">
        <div>
        <img class="me-img" src="/images/me.JPG" fetchpriority="high" />
        <p>Sakthi Vignesh Kumar | Growth Marketer</p>
        </div>
        <div>
        <img src="/images/icons/linkedin.png" alt="LinkedIn icon"/>
        <a href="https://linkedin.com/in/sakthi-vignesh-kumar-324ab9144" target="_blank" rel="me noopener">LinkedIn</a>
        </div>
        <div>
        <img src="/images/icons/email.png" alt="Email icon"/>
        <p>sakthivigneshvk@gmail.com</p>
        </div>
      </div>

      <div class="contact-links">
          <div>
          <img src="/images/icons/facebook-icon.png" alt="Facebook icon"/>
          <a href="https://www.facebook.com/skylanche/" target="_blank" rel="me noopener">Facebook</a>
          </div>
          <div>
          <img src="/images/icons/instagram-icon.png" alt="Instagram icon"/>
          <a href="https://www.instagram.com/skylanche/" target="_blank" rel="me noopener">Instagram</a>
          </div>
      </div>

</div>

   <div class="contact-form">
      <h2>Send a Message</h2>
      <form id="form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={ACCESS_KEY}>

        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required>

        <label for="email">Business Email</label>
        <input type="email" id="email" name="email" placeholder="your@company.com" required>

        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4" placeholder="Your message" required></textarea>

        <div class="h-captcha" data-sitekey={DATA_SITE_KEY} data-captcha="true"></div>

        <button type="submit">Send Message</button>
      </form>
    </div>
</div>

<style>
.contact-container{
display: flex;
flex-direction: row;
justify-content: space-between;
}

.contact-form {
      background: var(--dark);
      padding: 20px;
      border-radius: 8px;
      width: 400px;
      box-shadow: 0 0 10px var(--primary);
    }

   h2{
    margin-bottom: 15px;
   }

    input, textarea, button {
      width: 100%;
      margin: 15px 0;
      padding: 8px;
      border-radius: 4px;
      border: 1px solid #ccc;
    }

    label{
        color: var(--primary);
    }

    button {
      background: var(--primary);
      color: white;
      border: none;
      cursor: pointer;
      font-size: 18px;
      font-weight: bold;
    }

.contact{

  .contact-links{
  display: flex;
  flex-direction: column;
  padding: 20px;
  box-shadow: 0 0 10px var(--primary);
  background-color: var(--dark);
  margin-bottom: 30px;
  border-radius: 10px;

  div{
    display: flex;
    padding: 10px;
    gap: 10px;
    align-items: center;
    font-size: 20px;
  }
  }

  .me-img{
    width: 60px;
    border-radius: 50%;
  }

  img{
    width: 40px;
  }

  a{
    text-decoration: none;
    color: var(--primary);
  }
}

@media (max-width: 768px){

.contact-container{

  flex-direction: column;
  align-items: center;
}

}
</style>

<script define:vars={{ ACCESS_KEY }}>
const FORM_ACCESS_KEY = ACCESS_KEY

const form = document.getElementById('form');
const submitBtn = form.querySelector('button[type="submit"]');

form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    formData.append("access_key", FORM_ACCESS_KEY);

    const originalText = submitBtn.textContent;

    submitBtn.textContent = "Sending...";
    submitBtn.disabled = true;

    try {
        const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: formData
        });

        const data = await response.json();

        if (response.ok) {
            alert("Success! Your message has been sent.");
            form.reset();
        } else {
            alert("Error: " + data.message);
        }

    } catch (error) {
        alert("Something went wrong. Please try again.");
    } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
    }
});
</script>