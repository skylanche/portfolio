---
import Layout from "../layouts/Layout.astro";
---

<Layout metatitle="Thank You" metadescription="Contact Message received">
<main class="thanks-container">
      <div class="card">
        <div class="icon-circle">✓</div>
        <h1>Message Sent!</h1>
        <p>Thank you for reaching out. I have received your message and will get back to you as soon as possible.</p>
        <a href="/" class="home-btn">Back to Home</a>
      </div>
    </main>
</Layout>

<style>
  .thanks-container {
    display: flex;
    min-height: 100vh;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .card {
    max-width: 450px;
    text-align: center;
    background-color: var(--secondary);
    padding: 3rem 2rem;
    border-radius: 12px;
    box-shadow: 0 5px 15px 10px var(--primary);
  }
  .icon-circle {
    width: 60px;
    height: 60px;
    background-color: #10b981;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: bold;
    margin: 0 auto 1.5rem auto;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: #ffffff;
  }
  p {
    color: #9ca3af;
    line-height: 1.5;
    margin-bottom: 2rem;
  }
  .home-btn {
    display: inline-block;
    background-color: var(--primary);
    color: white;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    transition: background-color 0.2s;
  }
  .home-btn:hover {
    background-color: var(--secondary);
    color: var(--primary);
    box-shadow: 0 2px 5px 5px var(--primary);
  }
</style>